# --- x500 V1 (Algorand testnet, USDC x402 + ALGO escrow) ---
ALGORAND_NETWORK=algorand:testnet
ALGORAND_INDEXER_URL=https://testnet-idx.algonode.cloud
ALGORAND_ALGOD_URL=https://testnet-api.algonode.cloud
FACILITATOR_URL=https://facilitator.goplausible.xyz
USDC_TESTNET_ASA_ID=10458941

# Algorand addresses (base32)
ALGORAND_OPERATOR_ADDRESS=
ALGORAND_SETTLER_ADDRESS=
ALGORAND_AGENT_ADDRESS=
ALGORAND_MERCHANT_ADDRESS=
ALGORAND_TREASURY_ADDRESS=

# Mnemonics (25-word) — prefer separate keys in production
ALGORAND_OPERATOR_MNEMONIC=
ALGORAND_SETTLER_MNEMONIC=
ALGORAND_AGENT_MNEMONIC=

# Absolute path to deployments.algorand.testnet.json
X500_DEPLOYMENTS_PATH=
# Pool top-up in microAlgos (default 1 ALGO = 1000000)
X500_TOPUP_MICRO_ALGOS=1000000

# Algorand Supabase (dedicated project)
ALGORAND_SUPABASE_URL=
ALGORAND_SUPABASE_ANON_KEY=
ALGORAND_SUPABASE_SERVICE_ROLE_KEY=
ALGORAND_SUPABASE_DB_URL=

# Indexer
INDEXER_PORT=8787
INDEXER_URL=http://127.0.0.1:8787
INDEXER_CORS_ORIGIN=*
INDEXER_PUSH_SECRET=
INDEXER_SYNC_INTERVAL_MS=120000

# Dashboard
NEXT_PUBLIC_INDEXER_URL=http://127.0.0.1:8787
NEXT_PUBLIC_MARKET_PROXY_URL=http://127.0.0.1:8788
NEXT_PUBLIC_ALGORAND_NETWORK=testnet
NEXT_PUBLIC_ALGOD_SERVER=https://testnet-api.algonode.cloud
NEXT_PUBLIC_FACILITATOR_URL=https://facilitator.goplausible.xyz

# Settler
SETTLER_PORT=8789
SETTLER_POLL_MS=2000
SETTLER_BATCH_FLUSH_MS=5000
SETTLER_MAX_BATCH_SIZE=3
SETTLER_CLAIM_LIMIT=10
SETTLER_LEASE_SECONDS=120
SETTLER_MAX_ATTEMPTS=5
SETTLER_MIN_ALGO_MICRO=500000

# Market proxy + dummy upstream
DUMMY_UPSTREAM_PORT=8790
DUMMY_UPSTREAM_URL=http://127.0.0.1:8790
MARKET_PROXY_PORT=8788
MARKET_PROXY_URL=http://127.0.0.1:8788
MARKET_PROXY_BETA_KEY=
X500_AWAIT_SINK=

# Example server
SERVER_PORT=8800
NGROK_AUTHTOKEN=

# Agent / chat
GROQ_API_KEY=
X500_AGENT_ADDRESS=
ALGORAND_AGENT_MNEMONIC=
X500_MERCHANT_ORIGIN=
